# ============================================================================
# .gitattributes —— 一次配置，终身受益
#
# 核心作用：让所有文本文件在仓库里统一用 LF，避免 Windows 的 CRLF 引发：
#   ① 部署到 Linux 时报 `bad interpreter: /bin/bash^M`
#   ② 每次跨平台提交整个文件"看起来全变了"，代码评审没法看
# ============================================================================

# 默认：所有文本文件在仓库里统一用 LF
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须是 LF（部署脚本踩过这个坑）
*.sh text eol=lf

# 二进制文件不要做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.woff binary
*.woff2 binary

# 让 GitHub 语言统计更准确（不把 lock 文件算进代码量）
*.sum linguist-generated=true
web/package-lock.json linguist-generated=true

# 文档在 diff 里按 Markdown 渲染
*.md diff=markdown
