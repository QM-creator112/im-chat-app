# ============================================================================
# AI 侧车生产环境配置（systemd EnvironmentFile）
#
# 部署位置：/opt/im-chat/ai.env
# 权限：chown deploy:deploy && chmod 600
#
# 三种运行模式（/health 会如实报告）：
#   real     配了 LLM_API_KEY            → 真实调用大模型
#   mock     AI_MOCK=1 且没配 key        → 返回**标注 [MOCK]** 的模拟结果（仅验证链路）
#   disabled 两者都没有                  → 503，Go 侧降级为「AI 暂时不可用」
# ============================================================================

# ---------- 大模型 ----------
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 有 key 就填在这里（真实模式）；没有就留空并开 AI_MOCK=1。
LLM_API_KEY=
# 没有大模型 key 时设为 1，让侧车启动且能验证链路。
# ⚠️ 此时返回的内容带 [MOCK] 标记，**不是大模型输出**。上线前请换成真实 key。
AI_MOCK=1

# 显式超时（秒）。不设的话请求可能挂死，把调用方一起拖住。
AI_TIMEOUT_SECONDS=20
