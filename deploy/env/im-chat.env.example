# ============================================================================
# IM Chat 生产环境配置（systemd EnvironmentFile）
#
# 部署位置：/opt/im-chat/im-chat.env
# 权限：chown deploy:deploy && chmod 600   ← 必须，文件里有密码
#
# ⚠️ 这个文件绝对不能提交到 git。仓库里只有这个 .example 模板。
# ⚠️ systemd 的 EnvironmentFile 不支持 `export`，也不支持行尾注释，纯 KEY=VALUE。
#
# 下面所有「改成...」的地方都必须换成真实值，否则服务起不来（启动时会校验）。
# ============================================================================

# ---------- 运行环境 ----------
APP_ENV=production
APP_PORT=8080

# ---------- MySQL ----------
# 127.0.0.1 —— 不是 0.0.0.0。数据库只在回环地址上，公网连不到。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=im_app
DB_PASSWORD=改成你的数据库强密码
DB_NAME=im_chat

# 连接池参数（不填则用默认 25 / 10 / 3，与不配时行为一致）
# 注意：压测实测表明「调大它并不能解决单会话行锁瓶颈」，
# 只有在**多个会话并发写入**的场景才有帮助。详见 docs/05-压测报告.md §6。
DB_MAX_OPEN=25
DB_MAX_IDLE=10
DB_CONN_MAX_LIFETIME_MIN=3

# ---------- Redis ----------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=改成你的Redis强密码
REDIS_DB=0

# ---------- JWT ----------
# 生成方式（在服务器上执行，不要手敲）：
#   openssl rand -base64 48
# 长度必须 >= 32 字节，否则启动时直接报错退出。
JWT_SECRET=改成openssl生成的那串随机密钥
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ---------- AI 侧车 ----------
# 侧车也只监听本机回环。不配也行 —— 不配时 @AI 会降级成系统提示消息。
AI_BASE_URL=http://127.0.0.1:8090
