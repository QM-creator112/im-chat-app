# ============================================================================
# .gitignore —— 先写这个，再写代码
#
# Git 的特殊之处：即使你后来删了某个文件，它依然留在历史提交里，
# 任何人 clone 下来都能看到。所以「先提交了，等发现再删掉」是没有用的。
# ============================================================================

# ==================== 密钥与配置（最重要）====================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
config.yaml
config.local.yaml

# 本地专用 SQL（含真实密码，绝不入库）
# 通用模板 server/migrations/000_bootstrap.sql 只有占位符，那个是要提交的
server/migrations/local/

# ==================== Go ====================
# 编译产物
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
server/bin/

# 测试与覆盖率
*.test
*.out
coverage.out
coverage.html

# ==================== Node / 前端 ====================
node_modules/
web/dist/
web/dist-ssr/
.vite/
*.local

# 注意：package-lock.json 必须提交，不要写进来（CI 的 npm ci 依赖它）

# ==================== Python（AI 侧车）====================
ai/.venv/
ai/__pycache__/
__pycache__/
*.py[cod]
.pytest_cache/

# ==================== 编辑器与系统 ====================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ==================== 日志 ====================
logs/
*.log
npm-debug.log*

# ==================== 临时文件 ====================
tmp/
temp/
*.tmp
*.bak
