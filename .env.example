# ============================================================================
# .env.example —— 配置模板
#
# 这个文件**可以且应该提交到仓库**（它只有键名和占位值）。
# 真实配置放在 .env 里，而 .env 绝不能提交（已在 .gitignore 中）。
#
# 用法：
#   Copy-Item .env.example .env
#   然后编辑 .env，把占位值换成真实值
# ============================================================================

# ==================== 服务配置 ====================
APP_ENV=development
APP_PORT=8080

# ==================== MySQL ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=im_app
DB_PASSWORD=在这里填你在 000_bootstrap.sql 里设的密码
DB_NAME=im_chat

# ==================== Redis ====================
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT ====================
# 生成方式（PowerShell，任选其一）：
#
#   方式一：
#     $b = New-Object byte[] 48
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b)
#
#   方式二（有 openssl 时）：
#     openssl rand -base64 48
#
# ⚠️ 长度必须 >= 32 字节，程序启动时会校验，不够就直接报错退出
JWT_SECRET=在这里填一串至少 32 字节的随机字符串
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ==================== AI 侧车（Sprint 6）====================
AI_BASE_URL=http://127.0.0.1:8090
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=在这里填你的大模型 API Key
LLM_MODEL=deepseek-chat

# ==================== 前端（web/.env.local）====================
# 前端单独一份，不要和服务端共用
VITE_API_BASE=http://localhost:8080/api/v1
VITE_WS_BASE=ws://localhost:8080
